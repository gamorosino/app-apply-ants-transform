#!/bin/bash
#PBS -l nodes=1:ppn=1,vmem=8g,walltime=0:10:00
#PBS -N app-apply-transform
#PBS -V

set -e

# === Load fields from config.json ===
warp=$(jq -r .warp config.json)
inverse_warp=$(jq -r '."inverse-warp"' config.json)
affine=$(jq -r .affine config.json)
input_t1w=$(jq -r .input_t1 config.json)
input_tractmasks=$(jq -r .input_tractmasks config.json)
input_mask=$(jq -r .input_mask config.json)

# Diffusion metric maps to reslice (tensor: fa/md/rd/ad; NODDI: ndi/isovf/odi).
# Named "moving_*" to avoid colliding with the "fa"/"md"/... keys below, which
# feed the *fixed_tensor* (reference) input, not the thing being transformed.
# NODDI's "dir" (a 3-vector orientation field) is intentionally not included:
# reslicing its 3 components independently would rotate the directions
# incorrectly under anything beyond a pure translation.
moving_fa=$(jq -r '.moving_fa // empty' config.json)
moving_md=$(jq -r '.moving_md // empty' config.json)
moving_rd=$(jq -r '.moving_rd // empty' config.json)
moving_ad=$(jq -r '.moving_ad // empty' config.json)
moving_ndi=$(jq -r '.moving_ndi // empty' config.json)
moving_isovf=$(jq -r '.moving_isovf // empty' config.json)
moving_odi=$(jq -r '.moving_odi // empty' config.json)
interpolation=$(jq -r .interpolation config.json)
inverse=$(jq -r .inverse config.json)
affine_only=$(jq -r .affine_only config.json)
fsl_transform=$(jq -r .fsl_transform config.json)

# Optional anatomical fields
t1w=$(jq -r .t1 config.json)
t2w=$(jq -r .t2 config.json)
parc=$(jq -r .parc config.json)
mask=$(jq -r .mask config.json)
dwi=$(jq -r .dwi config.json)
fa=$(jq -r .fa config.json)
b0=$(jq -r .b0 config.json)

# === Assign first available anatomical reference ===
if [ -n "$t1w" ] && [ "$t1w" != "null" ]; then
    anat=$t1w
elif [ -n "$t2w" ] && [ "$t2w" != "null" ]; then
    anat=$t2w
elif [ -n "$parc" ] && [ "$parc" != "null" ]; then
    anat=$parc
elif [ -n "$mask" ] && [ "$mask" != "null" ]; then
    anat=$mask
elif [ -n "$dwi" ] && [ "$dwi" != "null" ]; then
    anat=$dwi
elif [ -n "$fa" ] && [ "$fa" != "null" ]; then
    anat=$fa
elif [ -n "$b0" ] && [ "$b0" != "null" ]; then
    anat=$b0
else
    echo "Error: No valid anatomical reference found in config.json" >&2
    exit 1
fi

[ "$interpolation" == "null" ] && interpolation="Linear"

# === Check for diffusion metric moving maps first (most specific case) ===
have_diffmetric=false
for v in "$moving_fa" "$moving_md" "$moving_rd" "$moving_ad" "$moving_ndi" "$moving_isovf" "$moving_odi"; do
    if [ -n "$v" ] && [ "$v" != "null" ]; then
        have_diffmetric=true
        break
    fi
done

if [ "$have_diffmetric" = true ]; then
    mkdir -p ./transformed
    for v in "$moving_fa" "$moving_md" "$moving_rd" "$moving_ad" "$moving_ndi" "$moving_isovf" "$moving_odi"; do
        if [ -n "$v" ] && [ "$v" != "null" ] && [ -f "$v" ]; then
            echo "Applying transform to diffusion metric map: $v"
            bash ./apply_transform.sh "$v" "$anat" "$warp" "$inverse_warp" "$affine" "$interpolation" "$inverse" "$affine_only" "$fsl_transform"
        fi
    done
# === Check if input_tractmasks folder exists and is not null ===
elif [ -n "$input_tractmasks" ] && [ "$input_tractmasks" != "null" ] && [ -d "$input_tractmasks" ]; then
    echo "Detected folder of tract masks: $input_tractmasks"
    find "$input_tractmasks" -type f \( -iname "*.nii" -o -iname "*.nii.gz" \) | while read -r mask_file; do
        echo "Applying transform to tract mask: $mask_file"
        bash ./apply_transform.sh "$mask_file" "$anat" "$warp" "$inverse_warp" "$affine" "$interpolation" "$inverse" "$affine_only" "$fsl_transform"
    done
elif [ -n "$input_mask" ] && [ "$input_mask" != "null" ] && [ -f "$input_mask" ]; then
    echo "Detected brain masks: $input_mask"
    echo "Applying transform to tract mask: $input_mask"
    bash ./apply_transform.sh "$input_mask" "$anat" "$warp" "$inverse_warp" "$affine" "$interpolation" "$inverse" "$affine_only" "$fsl_transform"
else
    # === Fallback: use input_t1w as input ===
    if [ -n "$input_t1w" ] && [ "$input_t1w" != "null" ]; then
        input=$input_t1w
        echo "Applying transform to input_t1: $input"
        bash ./apply_transform.sh "$input" "$anat" "$warp" "$inverse_warp" "$affine" "$interpolation" "$inverse" "$affine_only" "$fsl_transform"
    else
        echo "Error: No input file is defined in config.json" >&2
        exit 1
    fi
fi
